{
  "permissions": {
    "allow": [
      "Bash(scripts/agy-run.sh:*)",
      "Bash(bash scripts/agy-run.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git ls-files:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(date:*)",
      "Bash(mkdir -p .m10:*)",
      "Edit(.m10/**)",
      "Write(.m10/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
